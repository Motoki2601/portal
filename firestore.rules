rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the existing Portal documents use direct browser access.
    // Commerce reads and writes are mediated by the authenticated API.
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collection in ['wishlist', 'recipes', 'books']
        && docId == 'data';
    }
  }
}
